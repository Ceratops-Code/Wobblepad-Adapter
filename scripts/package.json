{
  "name": "repository-validation",
  "private": true,
  "description": "Repository Markdown validation tools.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:markdown": "markdownlint \"../**/*.md\" --ignore \"../**/node_modules/**\" --config .markdownlint.json"
  },
  "overrides": {
    "js-yaml": "5.4.1"
  },
  "devDependencies": {
    "markdownlint-cli": "0.49.1"
  }
}
